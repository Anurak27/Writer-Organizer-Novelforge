generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Book {
  id          String    @id @default(cuid())
  title       String
  description String?
  genre       String?
  status      String    @default("draft") // draft, in_progress, completed, on_hiatus
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chapters    Chapter[]
  codexEntries CodexEntry[]

  @@index([sortOrder])
}

model Chapter {
  id          String    @id @default(cuid())
  bookId      String
  title       String    @default("Untitled Chapter")
  synopsis    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  scenes      Scene[]

  @@unique([bookId, sortOrder])
  @@index([bookId, sortOrder])
}

model Scene {
  id          String    @id @default(cuid())
  chapterId   String
  title       String    @default("Untitled Scene")
  content     String    @default("")
  notes       String?
  status      String    @default("outline") // outline, draft, in_progress, needs_revision, complete
  wordCount   Int       @default(0)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, sortOrder])
  @@index([chapterId, sortOrder])
}

model CodexEntry {
  id          String    @id @default(cuid())
  bookId      String?   // null = global entry
  type        String    // character, location, lore, item
  name        String
  description String    @default("")
  aliases     String    @default("[]") // JSON array string
  tags        String    @default("[]") // JSON array string
  metadata    String    @default("{}") // JSON object string
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  book        Book?     @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([type])
}

model AiConfig {
  id              String    @id @default(cuid())
  provider        String    // openai, anthropic, openrouter, groq, cerebras, nararouter, google
  apiKey          String    // stored as-is (encrypted in Supabase prod)
  baseUrl         String?   // custom base URL for OpenAI-compatible providers
  modelName       String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}